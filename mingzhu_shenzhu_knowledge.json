  "gongzhu_into_palaces": {
    "命宫": {
      "命宫": {
        "heading": "1.命宫主 在 命宫：(代表自己稳定性程度)",
        "items": [
          "自我(我追求我自己)、自闭(当我自己)，一切以自己为出发点，会刑煞多会自残",
          "贪狼在子位、破军在午位或文曲在卯、酉位→其星曜之个性表现特别强烈明显",
          "巨门坐（亥）命时→自我、但有福德照（福德宫主亦入命），即使得罪他人，别人也无可奈何，继续帮忙"
        ],
        "source_rows": {
          "start": 90,
          "end": 93
        },
        "availability": "explicit"
      },
      "兄弟宫": {
        "heading": "3.命宫主 在 兄弟宫：（我去找兄弟，代表交际能力，重手足亲情）",
        "items": [
          "初运、人际关系、喜交朋友、串门子",
          "劫财、出卖与黏他",
          "喜欢交朋友(眉毛好→交到好朋友；眉毛不好→交到坏朋友，眉毛为兄弟交友宫)",
          "自己较依赖兄弟，可靠别人赚钱(如公司中的股东)"
        ],
        "source_rows": {
          "start": 98,
          "end": 102
        },
        "availability": "explicit"
      },
      "夫妻宫": {
        "heading": "4.命宫主 在 夫妻宫：(代表家庭，也为经营能力)",
        "items": [
          "注重家庭生活",
          "可自行开店，经营自营事业，若上班领人薪水，较懒",
          "命+福→夫：对家庭忠程度高(把家庭视为党派→忠于其党派)"
